{
  "name": "enso-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Fumadocs viewer for enso-crm docs, served at crm.enso.ro/docs",
  "scripts": {
    "sync-content": "node ./scripts/sync-content.mjs",
    "dev": "node ./scripts/sync-content.mjs && fumadocs-mdx && next dev",
    "build": "fumadocs-mdx && next build",
    "build:static": "node ./scripts/sync-content.mjs && fumadocs-mdx && next build",
    "start": "serve out",
    "types:check": "node ./scripts/sync-content.mjs && fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.11",
    "fumadocs-ui": "16.9.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
